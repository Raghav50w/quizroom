# Copy to .env and fill in. .env is gitignored — never commit it.
#
# Any OpenAI-compatible provider works; switching provider is an env change,
# not a code change. Gemini's OpenAI-compatible endpoint shown below.
#
# NEVER prefix an LLM key with VITE_ — Vite inlines VITE_* vars into the
# browser bundle, which would publish the key on a public site in a public repo.

# Neon pooled connection string. Keep sslmode=require.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

PORT=4000

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=paste-your-key-here
# Verified working on the free tier. gemini-flash-latest also works but moves
# under you; gemini-2.0-flash has a free-tier limit of 0 and 2.5 is retired.
LLM_MODEL=gemini-3.6-flash

# Embeddings for PDF retrieval, same key and base URL as above. Optional — the
# default below is used when unset. The 768 dimension is NOT configurable: it is
# pinned in the request and in the chunks.embedding column, and changing it means
# re-embedding every stored chunk.
EMBEDDING_MODEL=gemini-embedding-001

# Kill switch for all generation. Set to false to disable without redeploying.
GENERATION_ENABLED=true

# Fuse against a misbehaving retry loop, not against abuse.
DAILY_GENERATION_LIMIT=100
